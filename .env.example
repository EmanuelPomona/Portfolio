# Copy to .env in EACH worktree. scripts/bootstrap.sh does this for you and
# assigns non-colliding ports so several worktrees can run at once.

# Assigned by scripts/bootstrap.sh. Do not hardcode ports anywhere.
# frontend/vite.config.ts reads FRONTEND_PORT. BACKEND_PORT and VITE_API_BASE_URL are written by
# bootstrap.sh for every project but are unused here: there is no runtime backend (ADR-001).
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Deployed preview the reviewer inspects. Empty = reviewer falls back to local.
PREVIEW_URL=https://emanuel-ling-23mjaa59u-team-boh-buh.vercel.app

# This project needs no secrets at build or run time.
